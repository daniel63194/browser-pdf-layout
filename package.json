{
  "name": "browser-pdf-layout",
  "version": "0.1.0",
  "description": "Zero-backend utility to resize and add print margins to PDFs in the browser.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["pdf", "pdf-lib", "layout", "margins", "browser", "react", "print"],
  "author": "daniel63194",
  "license": "MIT",
 "dependencies": {
  "pdf-lib": "^1.17.1"
},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
"repository": {
  "type": "git",
  "url": "git+https://github.com/daniel63194/browser-pdf-layout.git"
}
}